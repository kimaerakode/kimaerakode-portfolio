<div class="theme-toggle">
    <label for="light-theme">
        <input type="radio" name="theme" id="light-theme" value="light" checked />
        [Light]
    </label>
    <label for="dark-theme">
        <input type="radio" name="theme" id="dark-theme" value="dark" />
        [Dark]
    </label>
</div>

<script>
  const themeColor = document.querySelector<HTMLMetaElement>('#theme-color');

  document.querySelectorAll<HTMLInputElement>('input[name="theme"]')
    .forEach((input) => {
      input.addEventListener('change', () => {
        if (themeColor) {
          themeColor.content =
            input.value === 'dark' ? '#0f0f11' : '#c3c3ce';
        }
      });
    });
</script>