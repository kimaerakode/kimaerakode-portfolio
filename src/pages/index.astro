---
import  KimaeraHeader  from '../components/KimaeraHeader.astro';
import  KimaeraFooter  from '../components/KimaeraFooter.astro';
import  Services  from '../components/Services.astro';
import FairyDustCursor from '../components/FairyDustCursor.tsx';

---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="color-scheme" content="light dark" />
		<meta name="theme-color" content="##0f0f11" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="stylesheet" href="/styles.css">
		<link rel="preload" href="/fonts/HIKARUMONO-regular.woff2" as="font" type="font/woff2" crossorigin="anonymous">
				<link rel="preload" href="/fonts/TTNormsProMonoVariable.woff2" as="font" type="font/woff2" crossorigin="anonymous">
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro</title>
	</head>
	<body>
		<FairyDustCursor
  client:only="react"

  particleSize={18}
  particleCount={1}
/>
	<KimaeraHeader/>
	<main>
		<section>
			<div>
		<p>I am Kimaerakode, a web developer and digital designer. My work inhabits a space where visually compelling interfaces and frontend logic intertwines.
</p>
<span>Based in Copenhagen, Denmark.</span>
</div>
<Services />
</section>
<img class="decoration" src="/assets/ascii-sparkle.svg" alt="">
	</main>
	<KimaeraFooter lastUpdated="3. November 2026" />
	</body>
</html>
